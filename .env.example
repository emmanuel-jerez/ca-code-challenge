# Copy to .env and adjust if needed. Defaults work for the challenge out of the box.

MYSQL_ROOT_PASSWORD=root
WORDPRESS_DB_NAME=wp
WORDPRESS_DB_USER=wp
WORDPRESS_DB_PASSWORD=wp
WORDPRESS_TABLE_PREFIX=wp_

# Seeded admin credentials (informational — re-run scripts/seed.sh to recreate)
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@example.com
WP_SITE_URL=http://localhost:8080
WP_SITE_TITLE="Brand Reviews Challenge"

# --- Main Django app (main-app/) ---
# Required outside local dev. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
MAIN_DB_NAME=brandreviews
MAIN_DB_USER=brandreviews
MAIN_DB_PASSWORD=brandreviews
# Host port for the main app's Postgres (bound to 127.0.0.1 only).
MAIN_DB_PORT=5433

# --- WordPress import ---
# Read-only MariaDB user the importer connects as (db/initdb/02-wp-import-user.sh).
WP_IMPORT_DB_USER=wp_import
WP_IMPORT_DB_PASSWORD=wp_import
# Host port for MariaDB (bound to 127.0.0.1 only), for running the import from the host.
WP_DB_PORT=3307

# --- Auth service (auth-service/) ---
# Required outside local dev; generate one as for DJANGO_SECRET_KEY.
AUTH_DJANGO_SECRET_KEY=
AUTH_DB_NAME=brandreviews_auth
AUTH_DB_USER=brandreviews_auth
AUTH_DB_PASSWORD=brandreviews_auth
# Host port for the auth service's Postgres (bound to 127.0.0.1 only).
AUTH_DB_PORT=5434
# The `iss` claim; the main app must expect the same value.
JWT_ISSUER=http://auth-service:8000
# Read-only MariaDB user the auth service's user import connects as
# (db/initdb/03-wp-auth-import-user.sh).
WP_AUTH_IMPORT_DB_USER=wp_auth_import
WP_AUTH_IMPORT_DB_PASSWORD=wp_auth_import
