    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "sass": "1.107.1",
